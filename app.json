{
  "expo": {
    "name": "Remédio na Hora",
    "slug": "remedio-na-hora",
    "version": "1.0.0",
    "description": "Lembrete de remédio com alarme: toca no horário cadastrado até você responder.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1f1b",
    "primaryColor": "#2bb673",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1f1b"
    },
    "ios": {
      "bundleIdentifier": "br.com.minanoideias.remedionahora",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.minanoideias.remedionahora",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0d1f1b"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Remédio na Hora",
      "shortName": "Remédio",
      "lang": "pt-BR",
      "themeColor": "#0d1f1b",
      "backgroundColor": "#0d1f1b",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1f1b",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2bb673",
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/alarme.wav"
          ]
        }
      ],
      "expo-asset"
    ]
  }
}
